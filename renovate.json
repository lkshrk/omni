{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"github>lkshrk/gh-ops//renovate/presets/app-library.json5",
		"github>lkshrk/gh-ops//renovate/presets/automerge-major.json5",
		"helpers:pinGitHubActionDigests"
	],
	"packageRules": [
		{
			"description": "Bun Group (bun panics unless its dialects share its exact version)",
			"groupName": "bun",
			"matchPackageNames": ["github.com/uptrace/bun", "github.com/uptrace/bun/**"],
			"group": {
				"commitMessageTopic": "{{{groupName}}} group"
			},
			"minimumGroupSize": 2
		}
	],
	"prConcurrentLimit": 5,
	"prHourlyLimit": 2,
	"timezone": "Europe/Berlin"
}
