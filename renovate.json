{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended", ":dependencyDashboard"],
	"rangeStrategy": "replace",
	"automerge": false,
	"automergeType": "pr",
	"automergeStrategy": "squash",
	"packageRules": [
		{
			"description": "Automerge non-major updates after CI passes",
			"matchUpdateTypes": ["patch", "minor", "digest", "pin"],
			"automerge": true
		},
		{
			"description": "Require manual review for major updates",
			"matchUpdateTypes": ["major"],
			"automerge": false
		},
		{
			"matchDepTypes": ["engines"],
			"enabled": false
		},
		{
			"description": "Bun Group (bun panics unless its dialects share its exact version)",
			"groupName": "bun",
			"matchPackageNames": ["github.com/uptrace/bun", "github.com/uptrace/bun/**"],
			"group": {
				"commitMessageTopic": "{{{groupName}}} group"
			},
			"minimumGroupSize": 2
		}
	],
	"lockFileMaintenance": {
		"enabled": true,
		"automerge": true,
		"automergeType": "branch",
		"schedule": ["before 4am on sunday"]
	},
	"prConcurrentLimit": 5,
	"prHourlyLimit": 2,
	"timezone": "Europe/Berlin"
}
